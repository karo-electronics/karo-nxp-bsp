        "meta-imx": {
            "git-remote": {
                "uri": "https://github.com/nxp-imx/meta-imx",
                "branch": "wrynose-6.18.37-2.1.0",
                "rev": "refs/tags/rel_imx_6.18.37_2.1.0"
            }
        },
        "meta-qt6": {
            "git-remote": {
                "uri": "https://github.com/YoeDistro/meta-qt6",
                "branch": "6.11",
                "rev": "302c4fab8d230f5cb7b21e4304c728831a0658cb"
            }
        },
        "meta-karo-nxp": {
            "git-remote": {
                "uri": "https://github.com/karo-electronics/meta-karo-nxp.git",
