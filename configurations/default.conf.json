        },
        "meta-karo-distro": {
            "git-remote": {
                "uri": "https://github.com/karo-electronics/meta-karo-distro.git",
                "branch": "wrynose",
                "rev": "refs/tags/wrynose-2026-11.1"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
        {
            "bb-layers": [
                "openembedded-core/meta",
                "meta-yocto/meta-poky",
                "meta-openembedded/meta-oe",
                "meta-openembedded/meta-multimedia",
                "meta-openembedded/meta-python",
                "meta-freescale",
                "meta-freescale-distro",
                "meta-freescale-ml",
                "meta-imx/meta-imx-bsp",
                "meta-imx/meta-imx-sdk",
                "meta-imx/meta-imx-ml",
                "meta-imx/meta-imx-v2x",
                "meta-arm/meta-arm",
                "meta-arm/meta-arm-toolchain",
                "meta-openembedded/meta-networking",
                "meta-openembedded/meta-filesystems",
                "meta-openembedded/meta-perl",
                "meta-qt6",
                "meta-karo-nxp",
                "meta-karo-distro"
            ],
            "setup-dir-name": "$distro-$machine-wrynose",
            "oe-fragments": [
                "karo-distro/diskmon-perf",
                "karo-distro/rpm-pkgs",
                "core/yocto/root-login-with-empty-password"
            ],
            "oe-fragments-one-of": {
                "machine": {
                    "description": "Target machines",
                    "options" : [
                        { "name": "machine/qs95-9610", "description": "i.MX 95 Ka-Ro QS95-9610 module" }
                    ]
                },
                "distro": {
                    "description": "Target distributions",
                    "options" : [
                        { "name": "distro/karo-minimal", "description": "Ka-Ro i.MX Minimal Distro" },
                        { "name": "distro/karo-wayland", "description": "Ka-Ro i.MX Distro with Wayland" },
                        { "name": "distro/karo-xwayland", "description": "Ka-Ro i.MX Distro with Wayland and X11 compatibility layer" }
                    ]
                },
                "baseboard": {
                    "description": "Target baseboard",
                    "options" : [
                        { "name": "baseboard/", "description": "No baseboard" },
                        { "name": "baseboard/qsbase95", "description": "Ka-Ro QSBase95 baseboard" }
                    ]
                }
            },
            "configurations": [
            {
                "name": "default",
                "description": "Setup default configuration",
                "oe-fragments": []
            },
            {
                "name": "default-with-eula",
                "description": "Accept Freescale/NXP EULA and setup default configuration",
                "oe-fragments": [
                    "freescale-layer/eula/accept-fsl-eula"
                ]
            }
            ]
        }
        ]
    },
    "version": "1.0"
}