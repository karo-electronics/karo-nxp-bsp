{
    "description": "Ka-Ro flavoured NXP i.MX Yocto Project BSP",
    "sources": {
        "bitbake": {
            "git-remote": {
                "uri": "https://git.openembedded.org/bitbake",
                "branch": "2.18",
                "rev": "a2dd9be788274d9c7280be5b1be5eb5c3990cf54"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://git.openembedded.org/openembedded-core",
                "branch": "wrynose",
                "rev": "42fa856a00ac16b2a7a83d7ecfa60a5be192b16c"
            }
        },
        "meta-yocto": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-yocto",
                "branch": "wrynose",
                "rev": "904846ae078ee20de073040ebb77c86e19250f56"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://github.com/openembedded/meta-openembedded",
                "branch": "wrynose",
                "rev": "420222862f5a6d95023b8f5f3b7e1808b2264ef9"
            }
        },
        "meta-freescale": {
            "git-remote": {
                "uri": "https://github.com/Freescale/meta-freescale",
                "branch": "master",
                "rev": "3949624f36cbc5b7fd4033ce5ef001d83fc1a3e9"
            }
        },
        "meta-freescale-distro": {
            "git-remote": {
                "uri": "https://github.com/Freescale/meta-freescale-distro",
                "branch": "master",
                "rev": "70b7591ecaa99cb6366f93ee05df7c38d94d724b"
            }
        },
        "meta-arm": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-arm",
                "branch": "master",
                "rev": "4112fda50b814ad6e3cfaefe5cad78a83114599a"
            }
        },
        "meta-imx": {
            "git-remote": {
                "uri": "https://github.com/nxp-imx/meta-imx",
                "branch": "wrynose-6.18.20-2.0.0",
                "rev": "refs/tags/rel_imx_6.18.20_2.0.0"
            }
        },
        "meta-karo-nxp": {
            "git-remote": {
                "uri": "ssh://git@buildserver-maxwell:2222/Ka-Ro/meta-karo-nxp.git",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-karo-distro": {
            "git-remote": {
                "uri": "ssh://git@buildserver-maxwell:2222/Ka-Ro/meta-karo-distro.git",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
        {
            "bb-layers": [
                "openembedded-core/meta",
                "meta-yocto/meta-poky",
                "meta-openembedded/meta-oe",
                "meta-openembedded/meta-multimedia",
                "meta-openembedded/meta-python",
                "meta-freescale",
                "meta-freescale-distro",
                "meta-imx/meta-imx-bsp",
                "meta-imx/meta-imx-sdk",
                "meta-imx/meta-imx-ml",
                "meta-imx/meta-imx-v2x",
                "meta-arm/meta-arm",
                "meta-arm/meta-arm-toolchain",
                "meta-openembedded/meta-networking",
                "meta-openembedded/meta-filesystems",
                "meta-openembedded/meta-perl",
                "meta-karo-nxp",
                "meta-karo-distro"
            ],
            "setup-dir-name": "$distro-$machine-wrynose",
            "oe-fragments-one-of": {
                "machine": {
                    "description": "Target machines",
                    "options" : [
                        { "name": "machine/qs95-5610", "description": "i.MX 95 Ka-Ro QS95-5610 module" }
                    ]
                },
                "distro": {
                    "description": "Target distributions",
                    "options" : [
                        { "name": "distro/karo-imx-minimal", "description": "Ka-Ro i.MX Minimal Distro" },
                        { "name": "distro/karo-imx-wayland", "description": "Ka-Ro i.MX Distro with Wayland" }
                    ]
                },
                "baseboard": {
                    "description": "Target baseboard",
                    "options" : [
                        { "name": "", "description": "No baseboard" },
                        { "name": "karo-imx/baseboard/qsbase95", "description": "Ka-Ro QSBase95 baseboard" }
                    ]
                }
            },
            "configurations": [
            {
                "name": "default",
                "description": "Setup default configuration",
                "oe-fragments": [
                    "karo-imx/diskmon-perf",
                    "karo-imx/debian-pkgs",
                    "core/yocto/root-login-with-empty-password"
                ]
            },
            {
                "name": "default-with-eula",
                "description": "Accept Freescale/NXP EULA and setup default configuration",
                "oe-fragments": [
                    "freescale-layer/eula/accept-fsl-eula",
                    "karo-imx/diskmon-perf",
                    "karo-imx/debian-pkgs",
                    "core/yocto/root-login-with-empty-password"
                ]
            }
            ]
        }
        ]
    },
    "version": "1.0"
}