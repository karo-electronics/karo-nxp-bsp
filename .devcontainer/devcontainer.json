{
  "name": "Yocto Dev Container - Wrynose",

  "build": {
    "dockerfile": "Dockerfile",
    "args": {
			"BASE_DISTRO": "ubuntu-24.04"
		}
  },

  "runArgs": [
    "--privileged"
  ],

  "remoteUser": "yoctouser",

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=delegated",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "mounts": [
    "source=yocto-shared-wrynose,target=/yocto-shared,type=volume",
    "source=/dev/,target=/dev/,type=bind,consistency=consistent"
  ],

  "containerEnv": {
    "DL_DIR": "/yocto-shared/downloads",
    "SSTATE_DIR": "/yocto-shared/sstate-cache",
    "BB_HASHSERVE_DB_DIR": "/yocto-shared/sstate-cache",
    "BB_ENV_PASSTHROUGH_ADDITIONS": "DL_DIR SSTATE_DIR BB_HASHSERVE_DB_DIR"
  }
}